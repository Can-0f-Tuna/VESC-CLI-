{
  "name": "@veac/serial",
  "version": "0.1.0",
  "description": "Serial port communication for VESC - wraps serialport for Bun compatibility",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node",
    "dev": "bun run --watch ./src/index.ts",
    "test": "bun test",
    "lint": "tsc --noEmit && echo 'Type check passed'",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@veac/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/serialport": "^8.0.5",
    "serialport": "^12.0.0",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "serialport": "^12.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  }
}
